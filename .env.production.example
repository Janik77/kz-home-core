# Inject these variables through the process/service environment.
# Core does not load a local .env when APP_ENV=production is explicitly set.
# Replace placeholders and supply secrets securely; never commit actual secrets.
# APP_ENV accepts development, test, local, production (case-insensitive).
# Booleans accept true/false, yes/no, on/off, 1/0; empty/unknown values fail.
APP_ENV=production
APP_DEBUG=false
KZHOME_SIMULATOR_ENABLED=false
# PostgreSQL is mandatory. Supply a real URL with URL-encoded credentials.
DATABASE_URL=postgresql+psycopg://kzhome:change-me@postgres.example.invalid:5432/kzhome
# Required: generate a unique random signing secret of at least 32 characters.
# Blank deliberately prevents startup until the secret is supplied.
AUTH_JWT_SECRET=
AUTH_JWT_ALGORITHM=HS256
AUTH_ACCESS_TOKEN_MINUTES=15
AUTH_REFRESH_TOKEN_DAYS=30
# Production requires MQTT enabled: no database-only virtual control fallback.
# An unavailable broker still reconnects in the background; it does not disable MQTT.
MQTT_ENABLED=true
MQTT_HOST=broker.example.invalid
MQTT_PORT=8883
MQTT_TLS_ENABLED=true
MQTT_KEEPALIVE=60
MQTT_CLIENT_ID=kzhome-core-installation-1
# Supply the Core broker credentials together. Enforce broker authentication/ACLs.
MQTT_USERNAME=
MQTT_PASSWORD=
# TLS verifies the broker using the runtime trust store; install a private CA there
# if needed. Use a unique client ID per Core instance and one application worker.
# Demo seeding is forbidden in production; do not run python -m app.seed.
