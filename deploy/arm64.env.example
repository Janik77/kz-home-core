# Copy to ignored deploy/local/arm64.env. Blank secrets intentionally fail config.
# Fresh project kzhome-arm64; never point this example at an existing database.
POSTGRES_PASSWORD=
DATABASE_URL=postgresql+psycopg://kzhome:REPLACE_URL_ENCODED_PASSWORD@postgres:5432/kzhome
AUTH_JWT_SECRET=
MQTT_PASSWORD=
MQTT_CLIENT_ID=kzhome-arm64-core-1
MQTT_ACL_FILE=./deploy/local/mqtt/acl
TZ=UTC
# Explicit host IP, e.g. 127.0.0.1 for a tunnel; no wildcard default.
HTTPS_BIND_IP=
CORE_ARM64_IMAGE=kz-home-core:v0.13-arm64
