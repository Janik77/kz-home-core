# Copy to deploy/local/production.env (gitignored), then fill locally.
# Compose reads this file; it is not mounted into any container.
# Separate PostgreSQL administrator password, used only by the postgres service.
POSTGRES_PASSWORD=
# Use the manually provisioned non-superuser kzhome role, URL-encode its password.
DATABASE_URL=postgresql+psycopg://kzhome:REPLACE_URL_ENCODED_PASSWORD@postgres:5432/kzhome
AUTH_JWT_SECRET=
# Must match the password provisioned for the broker user kzhome-core.
MQTT_PASSWORD=
MQTT_CLIENT_ID=kzhome-core-1
TZ=UTC
