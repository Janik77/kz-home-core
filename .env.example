DATABASE_URL=postgresql+psycopg://kzhome:change-me@localhost:5432/kzhome
APP_ENV=development
APP_DEBUG=false
KZHOME_SIMULATOR_ENABLED=false
MQTT_ENABLED=false
MQTT_HOST=
MQTT_PORT=1883
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_TLS_ENABLED=false
MQTT_KEEPALIVE=60
MQTT_CLIENT_ID=
# Development placeholder only. Production requires a unique random value of 32+ characters.
AUTH_JWT_SECRET=development-only-change-me-32-bytes
AUTH_JWT_ALGORITHM=HS256
AUTH_ACCESS_TOKEN_MINUTES=15
AUTH_REFRESH_TOKEN_DAYS=30
# Optional development-only seed credentials; leave unset in production.
AUTH_DEMO_EMAIL=
AUTH_DEMO_PASSWORD=
